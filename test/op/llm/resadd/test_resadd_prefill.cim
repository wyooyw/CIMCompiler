{% include 'op/common/def_special_regs.cim' %}
{% include 'op/common/simd.cim' %}

def set_special_regs(){
    SpecialRegSet(SPECIAL_REG_SIMD_INPUT_1_BIT_WIDTH, 16);
    SpecialRegSet(SPECIAL_REG_SIMD_INPUT_2_BIT_WIDTH, 16);
    SpecialRegSet(SPECIAL_REG_SIMD_OUTPUT_BIT_WIDTH, 16);

    SpecialRegSet(SPECIAL_REG_DTYPE_SIMD_IS_FLOAT, 1);
}

def main(){
    set_special_regs();
    
    x1_global = Buffer(<{{local_seqlen}}, {{hidden}}>, fp16, {{global_memory_name}});
    x2_global = Buffer(<{{local_seqlen}}, {{hidden}}>, fp16, {{global_memory_name}});
    y_global = Buffer(<{{local_seqlen}}, {{hidden}}>, fp16, {{global_memory_name}});
    x1_local = Buffer(<{{hidden}}>, fp16, __INPUT_MEMORY__);
    x2_local = Buffer(<{{hidden}}>, fp16, __INPUT_MEMORY__);
    y_local = Buffer(<{{hidden}}>, fp16, __OUTPUT_MEMORY__);

    @unroll
    for i in range({{local_seqlen}}) carry () {
        Trans(x1_global[i, :], x1_local);
        Trans(x2_global[i, :], x2_local);
        SIMD({{simd.vv_add}}, x1_local, x2_local, y_local);
        Trans(y_local, y_global[i, :]);
    };
}